{
  "name": "codex-session-dashboard",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "convex": "convex dev",
    "build": "pnpm run convex:prepare && vite build",
    "build:client": "vite build",
    "start": "vite preview",
    "convex:codegen": "convex codegen",
    "convex:prepare": "convex dev --once --typecheck disable",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "convex": "^1.34.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "jsdom": "^27.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.2",
    "vitest": "^4.0.8"
  }
}
